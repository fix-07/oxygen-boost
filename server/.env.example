# انسخ هذا الملف إلى .env ثم املأ القيم. لا ترفع .env إلى Git أبداً.

NODE_ENV=development
PORT=4000

# سرّ توقيع جلسات المشرف — ولّده بالأمر:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
TOKEN_TTL=2h

# مصادر الواجهة المسموح لها (افصل بينها بفاصلة)
CORS_ORIGIN=http://localhost:5173

# سلسلة اتصال MongoDB Atlas — من لوحة Atlas: Connect > Drivers
# مثال: mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/oxygen-boost?retryWrites=true&w=majority
MONGODB_URI=

# عدد الوسطاء الموثوقين أمام الخادم (0 محلياً، 1 خلف Nginx/Render)
TRUST_PROXY=0

# الشحن — تُحسب في الخادم دائماً
DELIVERY_FEE=10
FREE_DELIVERY_OVER=250
CURRENCY=LYD

# أقصى عدد طلبات لكل IP كل ١٥ دقيقة — ارفعه إن كان عملاؤك خلف شبكة مشغّل مشتركة
ORDER_RATE_LIMIT=20
MAX_QTY=10

# Gmail SMTP — فعّل التحقّق بخطوتين ثم أنشئ "كلمة مرور تطبيقات" من:
# https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
ORDER_EMAIL_TO=

# حساب المشرف — يُستخدم مرة واحدة بأمر npm run seed:admin ثم احذف كلمة المرور من هنا
ADMIN_EMAIL=
ADMIN_PASSWORD=
